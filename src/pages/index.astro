---
import App from '../components/App.astro';
import { HOME_FAQ, faqJsonLd, COUNTRIES, SITE_URL } from '../lib/seo.mjs';

const title = 'Travel Bestie: free day-by-day trip planner';
const description = 'Plan your trip to Singapore, Malaysia, Indonesia, Thailand, Vietnam, the Philippines or China in minutes: day-by-day itineraries, maps, entry fees, things to book and a budget estimate. Free, in English and Bahasa Indonesia.';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Travel Bestie', url: SITE_URL + '/', inLanguage: ['en', 'id'] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Travel Bestie', url: SITE_URL + '/', applicationCategory: 'TravelApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description,
    areaServed: COUNTRIES.map((c) => ({ '@type': 'Country', name: c.name })) },
  faqJsonLd(HOME_FAQ),
];
---
<App title={title} description={description} path="/" jsonld={jsonld} faq={HOME_FAQ}
  heading="Travel Bestie: your free trip planner"
  intro="Plan less, wander more. Pick a city, set your dates and budget, and get a day-by-day itinerary with maps, entry fees, things to book and a budget estimate. Share it with friends, save it as a PDF, or turn your trip into an Instagram story." />
