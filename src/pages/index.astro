---
import head from '../plan/head.html?raw';
import body from '../plan/body.html?raw';
import itineraries from '../plan/itineraries.html?raw';
import destinations from '../plan/destinations.html?raw';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>window.__tbHash=location.hash;</script>
    <Fragment set:html={head} />
  </head>
  <body>
    <Fragment set:html={body} />
    <Fragment set:html={itineraries} />
    <Fragment set:html={destinations} />
  </body>
</html>
